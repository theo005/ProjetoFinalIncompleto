@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Eagle IM</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
    <link rel="stylesheet" href="~/css/Login.css" />
</head>

<body>

    <div class="auth-wrapper">

        <!-- LADO DO LOGIN -->
        <div class="auth-side-form">

            <div class="auth-glow"></div>

            <div class="auth-container">

                <div class="auth-brand">
                    EAGLE <span>IM</span>
                </div>

                <h1 class="auth-title">Entrar</h1>

                <form id="account" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="form-floating mb-4">

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <label asp-for="Input.Email">Email</label>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small"></span>

                    </div>

                    <div class="form-floating mb-4 password-container">

                        <input asp-for="Input.Password"
                               class="form-control"
                               id="passwordInput"
                               autocomplete="current-password"
                               aria-required="true"
                               placeholder="password" />

                        <label asp-for="Input.Password">Senha</label>

                        <button type="button"
                                class="btn-show-password"
                                id="togglePassword"
                                aria-label="Mostrar senha">

                            <svg id="eyeIcon"
                                 xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>

                                <circle cx="12" cy="12" r="3"></circle>

                            </svg>

                        </button>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small"></span>

                    </div>

                    <div class="form-check mb-4">

                        <input class="form-check-input"
                               asp-for="Input.RememberMe" />

                        <label asp-for="Input.RememberMe"
                               class="form-check-label remember-label">

                            Lembrar-me neste dispositivo

                        </label>

                    </div>

                    <button id="login-submit"
                            type="submit"
                            class="w-100 btn btn-auth mb-4">

                        ENTRAR

                    </button>

                    <div class="text-center">

                        <a id="forgot-password"
                           asp-page="./ForgotPassword"
                           class="auth-link">

                            Esqueceu a senha? Clique Aqui!

                        </a>

                    </div>

                </form>

            </div>

        </div>


        <!-- LADO DIREITO -->
        <div class="auth-side-info">

            <div class="music-background"></div>

            <div class="mouse-glow"></div>

            <div class="particles"></div>

            <h2 class="welcome-text">
                Olá, bem-vindo!
            </h2>

            <p class="welcome-sub">
                Não possui uma conta?
            </p>

            <a asp-page="./Register"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="btn-outline-neon">

                CADASTRAR

            </a>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />


    <!-- PARTÍCULAS -->

    <script>

        const particlesContainer =
            document.querySelector(".particles");

        for (let i = 0; i < 25; i++) {

            const particle =
                document.createElement("span");

            particle.classList.add("particle");

            particle.style.left =
                Math.random() * 100 + "%";

            particle.style.animationDuration =
                (8 + Math.random() * 6) + "s";

            particle.style.animationDelay =
                Math.random() * 2 + "s";

            const tamanho =
                (1 + Math.random() * 3) + "px";

            particle.style.width = tamanho;

            particle.style.height = tamanho;

            particlesContainer.appendChild(particle);
        }

    </script>


    <!-- MOUSE GLOW -->

    <script>

        const mouseGlow =
            document.querySelector(".mouse-glow");

        const areaLogin =
            document.querySelector(".auth-side-info");

        areaLogin.addEventListener("mousemove", function (evento) {

            const rect =
                areaLogin.getBoundingClientRect();

            const x =
                evento.clientX - rect.left;

            const y =
                evento.clientY - rect.top;

            mouseGlow.style.left =
                x + "px";

            mouseGlow.style.top =
                y + "px";

        });

    </script>

    <script>
            const passwordInput = document.getElementById("passwordInput");
            const togglePassword = document.getElementById("togglePassword");

            togglePassword.addEventListener("click", function() {

                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    togglePassword.textContent = "🙈";
                } else {
                    passwordInput.type = "password";
                    togglePassword.textContent = "👁";
                }

            });

            passwordInput.addEventListener("input", function() {

                if (passwordInput.value.length > 0) {
                    passwordInput.parentElement.classList.add("has-text");
                } else {
                    passwordInput.parentElement.classList.remove("has-text");
                }

            });
    </script>

</body>
</html>