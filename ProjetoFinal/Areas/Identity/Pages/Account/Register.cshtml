@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Eagle IM</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

    <link rel="stylesheet"
          href="~/css/Register.css" />

</head>

<body>

    <div class="auth-wrapper">

        <!-- LADO ESQUERDO -->

        <div class="auth-side-info">

            <div class="music-background"></div>

            <div class="mouse-glow"></div>

            <div class="particles"></div>

            <h2 class="welcome-text">
                Já possui conta?
            </h2>

            <p class="welcome-sub">
                Faça login para acessar a plataforma.
            </p>

            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="btn-outline-neon">

                ENTRAR

            </a>

        </div>


        <!-- LADO DIREITO -->

        <div class="auth-side-form">

            <div class="auth-glow"></div>

            <div class="auth-container">

                <div class="auth-brand">

                    EAGLE <span>IM</span>

                </div>

                <h1 class="auth-title">
                    Cadastrar
                </h1>


                <form id="registerForm"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert">
                    </div>


                    <!-- EMAIL -->

                    <div class="form-floating mb-4">

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <label asp-for="Input.Email">
                            Email
                        </label>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- SENHA -->

                    <div class="form-floating mb-4 password-container">

                        <input asp-for="Input.Password"
                               class="form-control"
                               id="registerPassword"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="password" />

                        <label asp-for="Input.Password">
                            Senha
                        </label>

                        <button type="button"
                                class="btn-show-password"
                                id="toggleRegisterPassword"
                                aria-label="Mostrar senha">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>

                                <circle cx="12" cy="12" r="3"></circle>

                                <path class="eye-slash"
                                      d="M3 3l18 18">
                                </path>

                            </svg>

                        </button>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- CONFIRMAR SENHA -->

                    <div class="form-floating mb-4 password-container">

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               id="registerConfirmPassword"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="password" />

                        <label asp-for="Input.ConfirmPassword">
                            Confirmar Senha
                        </label>

                        <button type="button"
                                class="btn-show-password"
                                id="toggleRegisterConfirmPassword"
                                aria-label="Mostrar senha">

                            <svg xmlns="http://www.w3.org/2000/svg"
                                 viewBox="0 0 24 24"
                                 fill="none"
                                 stroke="currentColor"
                                 stroke-width="2"
                                 stroke-linecap="round"
                                 stroke-linejoin="round">

                                <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"></path>

                                <circle cx="12" cy="12" r="3"></circle>

                                <path class="eye-slash"
                                      d="M3 3l18 18">
                                </path>

                            </svg>

                        </button>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- BOTÃO -->

                    <button id="registerSubmit"
                            type="submit"
                            class="w-100 btn btn-auth">

                        CADASTRAR

                    </button>

                </form>

            </div>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>

            // =============================
            // PARTÍCULAS
            // =============================

            const particlesContainer =
                document.querySelector(".particles");

            for (let i = 0; i < 25; i++) {

                const particle =
                    document.createElement("span");

                particle.classList.add("particle");

                particle.style.left =
                    Math.random() * 100 + "%";

                particle.style.animationDuration =
                    (8 + Math.random() * 6) + "s";

                particle.style.animationDelay =
                    Math.random() * 2 + "s";

                const tamanho =
                    (1 + Math.random() * 3) + "px";

                particle.style.width = tamanho;
                particle.style.height = tamanho;

                particlesContainer.appendChild(particle);
            }


            // =============================
            // MOUSE GLOW
            // =============================

            const mouseGlow =
                document.querySelector(".mouse-glow");

            const areaLogin =
                document.querySelector(".auth-side-info");

            areaLogin.addEventListener("mousemove", function(evento) {

                const rect =
                    areaLogin.getBoundingClientRect();

                const x =
                    evento.clientX - rect.left;

                const y =
                    evento.clientY - rect.top;

                mouseGlow.style.left =
                    x + "px";

                mouseGlow.style.top =
                    y + "px";
            });


            // =============================
            // TRANSIÇÃO DE PÁGINA
            // =============================

            document.querySelectorAll("a").forEach(link => {

                link.addEventListener("click", function(evento) {

                    const destino =
                        this.href;

                    if (!destino ||
                        destino.startsWith("#") ||
                        this.target === "_blank") {
                        return;
                    }

                    evento.preventDefault();

                    document.body.classList.add("page-exit");

                    setTimeout(() => {

                        window.location.href =
                            destino;

                    }, 450);

                });

            });

    </script>

    <script>

            function configurarSenha(inputId, buttonId) {

                const passwordInput =
                    document.getElementById(inputId);

                const togglePassword =
                    document.getElementById(buttonId);

                const eyeSlash =
                    togglePassword.querySelector(".eye-slash");


                // Começa com o olho fechado
                eyeSlash.style.display = "block";


                // MOSTRAR / OCULTAR
                togglePassword.addEventListener("click", function() {

                    if (passwordInput.type === "password") {

                        // Mostra a senha
                        passwordInput.type = "text";

                        // Remove o risco
                        eyeSlash.style.display = "none";

                        togglePassword.setAttribute(
                            "aria-label",
                            "Ocultar senha"
                        );

                    } else {

                        // Esconde a senha
                        passwordInput.type = "password";

                        // Coloca o risco
                        eyeSlash.style.display = "block";

                        togglePassword.setAttribute(
                            "aria-label",
                            "Mostrar senha"
                        );

                    }

                });


                // APARECER O OLHO QUANDO DIGITAR
                passwordInput.addEventListener("input", function() {

                    if (passwordInput.value.length > 0) {

                        passwordInput.parentElement.classList.add("has-text");

                    } else {

                        passwordInput.parentElement.classList.remove("has-text");

                    }

                });

            }


            // SENHA
            configurarSenha(
                "registerPassword",
                "toggleRegisterPassword"
            );


            // CONFIRMAR SENHA
            configurarSenha(
                "registerConfirmPassword",
                "toggleRegisterConfirmPassword"
            );

    </script>

</body>

</html>