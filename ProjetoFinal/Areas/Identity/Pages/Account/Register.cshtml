@page
@model RegisterModel

@{
    ViewData["Title"] = "Register";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Eagle IM</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css" />

    <link rel="stylesheet"
          href="~/css/Register.css" />

</head>

<body>

    <div class="auth-wrapper">

        <!-- LADO ESQUERDO -->

        <div class="auth-side-info">

            <div class="music-background"></div>

            <div class="mouse-glow"></div>

            <div class="particles"></div>

            <h2 class="welcome-text">
                Já possui conta?
            </h2>

            <p class="welcome-sub">
                Faça login para acessar a plataforma.
            </p>

            <a asp-page="./Login"
               asp-route-returnUrl="@Model.ReturnUrl"
               class="btn-outline-neon">

                ENTRAR

            </a>

        </div>


        <!-- LADO DIREITO -->

        <div class="auth-side-form">

            <div class="auth-glow"></div>

            <div class="auth-container">

                <div class="auth-brand">

                    EAGLE <span>IM</span>

                </div>

                <h1 class="auth-title">
                    Cadastrar
                </h1>


                <form id="registerForm"
                      asp-route-returnUrl="@Model.ReturnUrl"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert">
                    </div>


                    <!-- EMAIL -->

                    <div class="form-floating mb-4">

                        <input asp-for="Input.Email"
                               class="form-control"
                               autocomplete="username"
                               aria-required="true"
                               placeholder="name@example.com" />

                        <label asp-for="Input.Email">
                            Email
                        </label>

                        <span asp-validation-for="Input.Email"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- SENHA -->

                    <div class="form-floating mb-4">

                        <input asp-for="Input.Password"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="password" />

                        <label asp-for="Input.Password">
                            Senha
                        </label>

                        <span asp-validation-for="Input.Password"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- CONFIRMAR SENHA -->

                    <div class="form-floating mb-4">

                        <input asp-for="Input.ConfirmPassword"
                               class="form-control"
                               autocomplete="new-password"
                               aria-required="true"
                               placeholder="password" />

                        <label asp-for="Input.ConfirmPassword">
                            Confirmar Senha
                        </label>

                        <span asp-validation-for="Input.ConfirmPassword"
                              class="text-danger small">
                        </span>

                    </div>


                    <!-- BOTÃO -->

                    <button id="registerSubmit"
                            type="submit"
                            class="w-100 btn btn-auth">

                        CADASTRAR

                    </button>

                </form>

            </div>

        </div>

    </div>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <partial name="_ValidationScriptsPartial" />

    <script>

            // =============================
            // PARTÍCULAS
            // =============================

            const particlesContainer =
                document.querySelector(".particles");

            for (let i = 0; i < 25; i++) {

                const particle =
                    document.createElement("span");

                particle.classList.add("particle");

                particle.style.left =
                    Math.random() * 100 + "%";

                particle.style.animationDuration =
                    (8 + Math.random() * 6) + "s";

                particle.style.animationDelay =
                    Math.random() * 2 + "s";

                const tamanho =
                    (1 + Math.random() * 3) + "px";

                particle.style.width = tamanho;
                particle.style.height = tamanho;

                particlesContainer.appendChild(particle);
            }


            // =============================
            // MOUSE GLOW
            // =============================

            const mouseGlow =
                document.querySelector(".mouse-glow");

            const areaLogin =
                document.querySelector(".auth-side-info");

            areaLogin.addEventListener("mousemove", function(evento) {

                const rect =
                    areaLogin.getBoundingClientRect();

                const x =
                    evento.clientX - rect.left;

                const y =
                    evento.clientY - rect.top;

                mouseGlow.style.left =
                    x + "px";

                mouseGlow.style.top =
                    y + "px";
            });


            // =============================
            // TRANSIÇÃO DE PÁGINA
            // =============================

            document.querySelectorAll("a").forEach(link => {

                link.addEventListener("click", function(evento) {

                    const destino =
                        this.href;

                    if (!destino ||
                        destino.startsWith("#") ||
                        this.target === "_blank") {
                        return;
                    }

                    evento.preventDefault();

                    document.body.classList.add("page-exit");

                    setTimeout(() => {

                        window.location.href =
                            destino;

                    }, 450);

                });

            });

    </script>

</body>

</html>