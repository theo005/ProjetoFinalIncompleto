
<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProjetoFinal</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ProjetoFinal.styles.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">

            <div class="container-fluid">

                <!-- BOTÃO DO MENU LATERAL -->
                <button class="btn menu-button"
                        type="button"
                        data-bs-toggle="offcanvas"
                        data-bs-target="#menuLateral"
                        aria-label="Abrir menu">
                    ☰
                </button>

                <!-- LOGO -->
                <a class="navbar-brand"
                   href="/"
                   style="color: #d100ff; font-weight: bold;">
                    Eagle IM
                </a>

                <!-- BOTÃO RESPONSIVO -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#menuNavegacao">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- ÁREA DA NAVBAR -->
                <div class="collapse navbar-collapse" id="menuNavegacao">

                    <div class="d-flex flex-column flex-lg-row align-items-center ms-auto gap-3 mt-3 mt-lg-0">

                        <!-- PESQUISA -->
                        <form class="d-flex w-100">

                            <input class="form-control me-2"
                                   type="search"
                                   placeholder="Search"
                                   style="border-color: #d100ff; background-color: #1a1a1a; color: white;">

                            <button class="btn"
                                    type="submit"
                                    style="background-color: #d100ff; color: black; font-weight: bold;">
                                Search
                            </button>

                        </form>

                        <!-- LOGIN -->
                        <div class="w-100 text-center text-lg-start">
                            <partial name="_LoginPartial" />
                        </div>

                    </div>

                </div>

            </div>

        </nav>

        <!-- MENU LATERAL -->

        <div class="offcanvas offcanvas-start menu-lateral"
             tabindex="-1"
             id="menuLateral">

            <!-- CABEÇALHO DO MENU -->
            <div class="offcanvas-header">

                <h5 class="offcanvas-title titulo-menu">
                    Eagle IM
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="offcanvas">
                </button>

            </div>

            <!-- CORPO DO MENU -->
            <div class="offcanvas-body">

                <!-- ÓRGÃO -->

                <button class="item-menu item-menu-botao"
                        type="button">

                    Órgão

                    <span>›</span>

                </button>

                <div class="submenu">

                    <a asp-controller="Instrumentos" asp-action="OrgaosDeIgreja">
                        Órgãos de Igreja
                    </a>

                    <a asp-controller="Instrumentos" asp-action="OrgaosEletricos">
                        Órgãos Elétricos
                    </a>

                    <a asp-controller="Instrumentos" asp-action="OrgaosDigitais">
                        Órgãos Digitais
                    </a>

                </div>

                <!-- MADEIRAS -->

                <button class="item-menu item-menu-botao"
                        type="button">

                    Madeiras

                    <span>›</span>

                </button>

                <div class="submenu">

                    <a asp-controller="Instrumentos" asp-action="Flautas">
                        Flautas
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Clarinete">
                        Clarinete
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Saxofones">
                        Saxofones
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Oboes">
                        Oboés
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Fagotes">
                        Fagotes
                    </a>

                    <a asp-controller="Instrumentos" asp-action="FlautasDoces">
                        Flautas Doces
                    </a>

                </div>

                <!-- METAIS -->

                <button class="item-menu item-menu-botao"
                        type="button">

                    Metais

                    <span>›</span>

                </button>

                <div class="submenu">

                    <a asp-controller="Instrumentos" asp-action="Trompetes">
                        Trompetes
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Trombones">
                        Trombones
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Trompas">
                        Trompas
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Tubas">
                        Tubas
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Eufonios">
                        Eufônios
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Cornets">
                        Cornets
                    </a>

                </div>

                <!-- CORDAS -->

                <button class="item-menu item-menu-botao"
                        type="button">

                    Cordas

                    <span>›</span>

                </button>

                <div class="submenu">

                    <a asp-controller="Instrumentos" asp-action="Violoes">
                        Violões
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Guitarras">
                        Guitarras
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Baixos">
                        Baixos
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Violinos">
                        Violinos
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Violas">
                        Violas
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Cellos">
                        Cellos
                    </a>

                </div>

                <!-- TECLAS -->

                <button class="item-menu item-menu-botao"
                        type="button">

                    Teclas

                    <span>›</span>

                </button>

                <div class="submenu">

                    <a asp-controller="Instrumentos" asp-action="Pianos">
                        Pianos
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Teclados">
                        Teclados
                    </a>

                    <a asp-controller="Instrumentos" asp-action="PianosDigitais">
                        Pianos Digitais
                    </a>

                    <a asp-controller="Instrumentos" asp-action="OrgaosEletronicos">
                        Órgãos Eletrônicos
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Sintetizadores">
                        Sintetizadores
                    </a>

                    <a asp-controller="Instrumentos" asp-action="ControladoresMidi">
                        Controladores MIDI
                    </a>

                </div>

                <!-- PERCUSSÃO -->

                <button class="item-menu item-menu-botao"
                        type="button">

                    Percussão

                    <span>›</span>

                </button>

                <div class="submenu">

                    <a asp-controller="Instrumentos" asp-action="Baterias">
                        Baterias
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Cajons">
                        Cajons
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Pandeiros">
                        Pandeiros
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Tambores">
                        Tambores
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Xilofones">
                        Xilofones
                    </a>

                    <a asp-controller="Instrumentos" asp-action="Pratos">
                        Pratos
                    </a>

                </div>

            </div>

        </div>

    </header>

    <!-- CONTEÚDO PRINCIPAL -->

    <div class="container">

        <main role="main" class="pb-4">

            @RenderBody()

        </main>

    </div>

    <!-- FOOTER EAGLE IM -->

    <footer class="eagle-footer">

        <div class="eagle-footer-main">

            <!-- IDENTIDADE DA LOJA -->
            <section class="eagle-footer-brand">

                <a asp-controller="Instrumentos"
                   asp-action="Index"
                   class="eagle-footer-logo">
                    EAGLE <span>IM</span>
                </a>

                <p>
                    Encontre os instrumentos ideais para transformar
                    sua paixão pela música em realidade.
                </p>

                <div class="eagle-payment" id="formasPagamento">

                    <h3>Formas de pagamento</h3>

                    <img src="~/img/FormasPagamento.png"
                         alt="Formas de pagamento aceitas" />

                </div>

            </section>

            <!-- CATEGORIAS -->
            <section class="eagle-footer-column">

                <h3>Explore nossa loja</h3>

                <a asp-controller="Instrumentos" asp-action="Orgao">
                    Órgãos
                </a>

                <a asp-controller="Instrumentos" asp-action="Madeiras">
                    Madeiras
                </a>

                <a asp-controller="Instrumentos" asp-action="Metais">
                    Metais
                </a>

                <a asp-controller="Instrumentos" asp-action="Cordas">
                    Cordas
                </a>

                <a asp-controller="Instrumentos" asp-action="Teclas">
                    Teclas
                </a>

                <a asp-controller="Instrumentos" asp-action="Percussao">
                    Percussão
                </a>

            </section>

            <!-- INSTITUCIONAL -->
            <section class="eagle-footer-column">

                <h3>Institucional</h3>

                <a asp-controller="Home" asp-action="Privacy">
                    Política de privacidade
                </a>

                <a href="#">
                    Quem somos
                </a>

                <a href="#formasPagamento">
                    Formas de pagamento
                </a>

            </section>

            <!-- SUPORTE E CONTATO -->
            <section class="eagle-footer-column">

                <h3>Suporte</h3>

                <a href="#">
                    Fale conosco
                </a>

                <a href="#">
                    Dúvidas frequentes
                </a>

                <a href="#">
                    Trocas e devoluções
                </a>

            </section>

        </div>

        <!-- RODAPÉ INFERIOR -->
        <div class="eagle-footer-bottom">

            <p>
                &copy; @DateTime.Now.Year Eagle IM.
                Todos os direitos reservados.
            </p>

            <a href="#">Voltar ao início ↑</a>

        </div>

    </footer>

    <!-- SCRIPTS -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"
            asp-append-version="true">
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
