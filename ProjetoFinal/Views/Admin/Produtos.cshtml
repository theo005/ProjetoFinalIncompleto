@{
    ViewData["Title"] = "Produtos";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eagle IM | Produtos</title>
    <link rel="stylesheet" href="~/css/Admin.css" asp-append-version="true" />
</head>
<body>
    <aside class="sidebar">
        <div class="logo">
            <h2>EAGLE <span>IM</span></h2>
            <p>PAINEL ADMINISTRATIVO</p>
        </div>
        <nav>
            <a asp-action="Index">Dashboard</a>
            <a class="active" asp-action="Produtos">Produtos</a>
            <a asp-action="Categorias">Categorias</a>
            <a asp-action="Clientes">Clientes</a>
            <a asp-action="Pedidos">Pedidos</a>
        </nav>
        <div class="sidebar-footer">
            <a asp-controller="Instrumentos" asp-action="Index">Voltar para a loja</a>
        </div>
    </aside>

    <main class="main-content">
        <header class="topbar">
            <div>
                <h1>Produtos</h1>
                <p>Gerencie os instrumentos da sua loja.</p>
            </div>
            <div class="admin-profile">Administrador</div>
        </header>

        <section class="page-heading">
            <div>
                <h2>Catálogo de produtos</h2>
                <p>Consulte e gerencie os produtos cadastrados.</p>
            </div>
            <button class="primary-button" type="button">+ Adicionar produto</button>
        </section>

        <section class="content-card">
            <div class="table-header">
                <h3>Todos os produtos</h3>
                <input type="search" placeholder="Pesquisar produto..." />
            </div>

            <div class="empty-state">
                <h3>Nenhum produto exibido</h3>
                <p>Quando conectarmos o painel ao cadastro de instrumentos, seus produtos aparecerão aqui.</p>
            </div>
        </section>
    </main>
</body>
</html>
